# Copy to .env_vme_automation_bot in the repo root.
# Do not commit .env_vme_automation_bot — it contains the bot API token.
#
# This skill uses the VME Automation Bot by default (see load_vme_bot_env.sh).

export JIRA_URL=https://redhat.atlassian.net
export JIRA_USERNAME=vme-automation-bot@redhat.com
export JIRA_API_TOKEN=your-bot-api-token-here
