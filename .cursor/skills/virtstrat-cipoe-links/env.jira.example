# Copy to .env_jira in the repo root (or use existing .env_wilker_jira).
# Do not commit .env_jira — it contains your API token.
#
# Create token: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_URL=https://redhat.atlassian.net
JIRA_USERNAME=you@redhat.com
JIRA_API_TOKEN=your-api-token-here
