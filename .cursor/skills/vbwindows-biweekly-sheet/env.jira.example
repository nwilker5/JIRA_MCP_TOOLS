# Copy to repo root as .env_jira (your personal Jira credentials).
# Do not commit .env_jira. Do not use someone else's token.

export JIRA_URL=https://redhat.atlassian.net
export JIRA_USERNAME=your-email@redhat.com
export JIRA_API_TOKEN=your-api-token-here

# Optional — defaults to the shared VBWindows Executive Brief spreadsheet
# export VBWINDOWS_SHEET_ID=12NsWug2zDvtd1_ry9cZBFM_Fgv4fM7yBZND0PudMCoU
