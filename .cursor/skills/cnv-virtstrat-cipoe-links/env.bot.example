# Copy to .env_vme_automation_bot in the repo root.
# Do not commit this file — it contains the bot API token.
#
# Create token (as the bot user): https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_URL=https://redhat.atlassian.net
JIRA_USERNAME=vme-automation-bot@redhat.com
JIRA_API_TOKEN=your-bot-api-token-here
