# Copy to .env_jira in the repo root (or your working directory).
# Do not commit .env_jira — it contains your API token.
#
# Create token: https://id.atlassian.com/manage-profile/security/api-tokens

export JIRA_URL=https://redhat.atlassian.net
export JIRA_USERNAME=you@redhat.com
export JIRA_API_TOKEN=your-api-token-here

# Alternative variable name (either works):
# export JIRA_EMAIL=you@redhat.com
